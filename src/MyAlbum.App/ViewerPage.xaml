<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyAlbum_App.ViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:MyAlbum_App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True">

    <Page.Resources>
        <conv:StarGlyphConverter x:Key="StarGlyph" />
        <conv:StarBrushConverter x:Key="StarBrush" />
    </Page.Resources>

    <Grid x:Name="ViewerRoot" Background="#FF101010">
        <ScrollViewer
            x:Name="ZoomScroller"
            ZoomMode="Enabled"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollMode="Enabled">
            <Grid
                x:Name="PhotoHost"
                MinWidth="0"
                MinHeight="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Image
                    x:Name="PhotoImage"
                    Stretch="Uniform"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ImageOpened="PhotoImage_OnImageOpened"
                    SizeChanged="PhotoImage_OnSizeChanged"
                    PointerPressed="PhotoImage_OnPointerPressed"
                    PointerMoved="PhotoImage_OnPointerMoved"
                    PointerReleased="PhotoImage_OnPointerReleased"
                    DoubleTapped="PhotoImage_OnDoubleTapped" />
            </Grid>
        </ScrollViewer>

        <!-- Top-left: file name + position -->
        <StackPanel
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="16"
            Padding="12,8"
            Spacing="2"
            CornerRadius="6"
            Background="#66000000">
            <TextBlock x:Name="FileNameText" Foreground="White" TextWrapping="NoWrap" />
            <TextBlock x:Name="PositionText" Foreground="#B3FFFFFF" FontSize="12" />
        </StackPanel>

        <!-- Bottom bar: rating + close -->
        <Border
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Background="#CC101010"
            Padding="16,8">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                    <TextBlock
                        Text="评分"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        Foreground="#B3FFFFFF" />
                    <Button x:Name="Star1" Background="Transparent" BorderThickness="0" Padding="2" Click="Star_OnClick" Tag="1">
                        <FontIcon Glyph="{x:Bind Rating, Mode=OneWay, Converter={StaticResource StarGlyph}, ConverterParameter=1}" Foreground="{x:Bind Rating, Mode=OneWay, Converter={StaticResource StarBrush}, ConverterParameter=1}" FontSize="20" />
                    </Button>
                    <Button x:Name="Star2" Background="Transparent" BorderThickness="0" Padding="2" Click="Star_OnClick" Tag="2">
                        <FontIcon Glyph="{x:Bind Rating, Mode=OneWay, Converter={StaticResource StarGlyph}, ConverterParameter=2}" Foreground="{x:Bind Rating, Mode=OneWay, Converter={StaticResource StarBrush}, ConverterParameter=2}" FontSize="20" />
                    </Button>
                    <Button x:Name="Star3" Background="Transparent" BorderThickness="0" Padding="2" Click="Star_OnClick" Tag="3">
                        <FontIcon Glyph="{x:Bind Rating, Mode=OneWay, Converter={StaticResource StarGlyph}, ConverterParameter=3}" Foreground="{x:Bind Rating, Mode=OneWay, Converter={StaticResource StarBrush}, ConverterParameter=3}" FontSize="20" />
                    </Button>
                    <Button x:Name="Star4" Background="Transparent" BorderThickness="0" Padding="2" Click="Star_OnClick" Tag="4">
                        <FontIcon Glyph="{x:Bind Rating, Mode=OneWay, Converter={StaticResource StarGlyph}, ConverterParameter=4}" Foreground="{x:Bind Rating, Mode=OneWay, Converter={StaticResource StarBrush}, ConverterParameter=4}" FontSize="20" />
                    </Button>
                    <Button x:Name="Star5" Background="Transparent" BorderThickness="0" Padding="2" Click="Star_OnClick" Tag="5">
                        <FontIcon Glyph="{x:Bind Rating, Mode=OneWay, Converter={StaticResource StarGlyph}, ConverterParameter=5}" Foreground="{x:Bind Rating, Mode=OneWay, Converter={StaticResource StarBrush}, ConverterParameter=5}" FontSize="20" />
                    </Button>
                </StackPanel>
                <Button Grid.Column="1" Click="Close_OnClick" ToolTipService.ToolTip="关闭 (Esc)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8BB;" FontSize="14" />
                        <TextBlock Text="关闭" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
