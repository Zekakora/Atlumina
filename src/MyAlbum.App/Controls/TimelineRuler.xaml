<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MyAlbum_App.Controls.TimelineRuler"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--
          Semi-transparent gradient backing for the ruler so the ticks / year labels stay
          readable over the photo wall in both themes. Base-opacity is shown all the time;
          hovering the ruler fades it to near-opaque (see TimelineRuler.xaml.cs OnActivated).
        -->
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="RulerScrimBrush" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#00FFFFFF" />
                        <GradientStop Offset="0.55" Color="#4DFFFFFF" />
                        <GradientStop Offset="1" Color="#E6FFFFFF" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <LinearGradientBrush x:Key="RulerScrimBrush" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#00000000" />
                        <GradientStop Offset="0.55" Color="#4D000000" />
                        <GradientStop Offset="1" Color="#E6000000" />
                    </LinearGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
      Desktop timeline scrubber overlaid on the photo area (no separate column).
      - Inactive: a faint hairline hint + gradient backing on the right edge.
      - Hover: the ruler (track + year/month ticks + thumb) fades in, tooltip shows month.
      - Drag: immediate scroll + day-precision tooltip.
      Hit zone is only the right strip; the rest of the control is non-interactive overlay.
    -->
    <Grid x:Name="Root" Width="210" HorizontalAlignment="Right" Margin="0,0,0,28">
        <!-- Hit zone (right strip) -->
        <Border x:Name="HitStrip" Width="38" HorizontalAlignment="Right" Background="Transparent" />

        <!-- Semi-transparent gradient backing, always slightly visible, stronger on hover -->
        <Rectangle
            x:Name="Scrim"
            Fill="{ThemeResource RulerScrimBrush}"
            Opacity="0.5"
            IsHitTestVisible="False" />

        <!-- Faint hairline affordance (always) -->
        <Rectangle
            x:Name="HintLine"
            Width="3"
            HorizontalAlignment="Right"
            Margin="0,0,16,0"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
            Opacity="0.35"
            IsHitTestVisible="False" />

        <!-- Ruler visuals (fade in on hover) -->
        <Grid x:Name="RulerVisual" Opacity="0" IsHitTestVisible="False">
            <Rectangle
                x:Name="TrackLine"
                Width="3"
                HorizontalAlignment="Right"
                Margin="0,0,16,0"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                Opacity="0.65" />
            <Canvas x:Name="TickCanvas" Width="38" HorizontalAlignment="Right" />
            <Border
                x:Name="Thumb"
                Width="11"
                Height="48"
                HorizontalAlignment="Right"
                Margin="0,0,12,0"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="5.5" />
            <Canvas x:Name="LabelCanvas" Width="120" HorizontalAlignment="Right" Margin="0,0,36,0" />
        </Grid>

        <!-- Date tooltip: right-aligned, hugging the scrollbar (8px gap from the strip) -->
        <Border
            x:Name="TooltipCard"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,0,30,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="7"
            Padding="12,5"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <TextBlock x:Name="TooltipText" FontSize="13" />
        </Border>
    </Grid>
</UserControl>
