<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MyAlbum_App.Controls.TimelineRuler"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      Desktop timeline scrubber overlaid on the photo area (no separate column).
      - Inactive: only a faint hairline hint on the right edge.
      - Hover: the ruler (track + year/month ticks + thumb) fades in, tooltip shows month.
      - Drag: immediate scroll + day-precision tooltip.
      Hit zone is only the right strip; the rest of the control is non-interactive overlay.
    -->
    <Grid x:Name="Root" Width="170" HorizontalAlignment="Right">
        <!-- Hit zone (right strip) -->
        <Border x:Name="HitStrip" Width="26" HorizontalAlignment="Right" Background="Transparent" />

        <!-- Faint hairline affordance (always) -->
        <Rectangle
            x:Name="HintLine"
            Width="2"
            HorizontalAlignment="Right"
            Margin="0,0,12,0"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
            Opacity="0.2"
            IsHitTestVisible="False" />

        <!-- Ruler visuals (fade in on hover) -->
        <Grid x:Name="RulerVisual" Opacity="0" IsHitTestVisible="False">
            <Rectangle
                x:Name="TrackLine"
                Width="2"
                HorizontalAlignment="Right"
                Margin="0,0,13,0"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                Opacity="0.6" />
            <Canvas x:Name="TickCanvas" Width="26" HorizontalAlignment="Right" />
            <Border
                x:Name="Thumb"
                Width="6"
                Height="48"
                HorizontalAlignment="Right"
                Margin="0,0,11,0"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="3" />
            <Canvas x:Name="LabelCanvas" Width="92" HorizontalAlignment="Right" Margin="0,0,32,0" />
        </Grid>

        <!-- Date tooltip: right-aligned, hugging the scrollbar (8px gap from the strip) -->
        <Border
            x:Name="TooltipCard"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,0,34,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10,4"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <TextBlock x:Name="TooltipText" FontSize="12" />
        </Border>
    </Grid>
</UserControl>
