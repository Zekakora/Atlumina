<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyAlbum_App.Pages.DedupToolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MyAlbum_App.ViewModels"
    xmlns:conv="using:MyAlbum_App.Converters"
    xmlns:controls="using:MyAlbum_App.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <LinearGradientBrush
            x:Key="ThumbCaptionBrush"
            StartPoint="0,0"
            EndPoint="0,1">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#66000000" Offset="0.45" />
            <GradientStop Color="#E6000000" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="GroupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="OccurrenceRowStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Page.Resources>

    <Grid Padding="20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ProtectionBanner Grid.Row="0" />

        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="去重检测" FontSize="20" FontWeight="SemiBold" />
            <TextBlock
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="2">
            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ViewModel.HasGroups, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DedupGroupItem">
                            <Border Style="{StaticResource GroupCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Text="{x:Bind Title}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        TextWrapping="Wrap">
                                        <ToolTipService.ToolTip>
                                            <ToolTip>
                                                <TextBlock Text="{x:Bind AllPathsText}" TextWrapping="Wrap" MaxWidth="520" FontSize="12" />
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                    </TextBlock>

                                    <ItemsControl ItemsSource="{x:Bind Occurrences}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DedupOccurrenceItem">
                                                <Border Style="{StaticResource OccurrenceRowStyle}">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                                <TextBlock
                                                                    Text="{x:Bind Directory}"
                                                                    FontSize="12"
                                                                    VerticalAlignment="Center"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    ToolTipService.ToolTip="{x:Bind Directory}" />
                                                            </StackPanel>
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Text="{x:Bind FormatsText}"
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                VerticalAlignment="Center"
                                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                            <Border
                                                                Grid.Column="2"
                                                                Padding="7,2"
                                                                CornerRadius="8"
                                                                Background="#D92932"
                                                                VerticalAlignment="Center"
                                                                Visibility="{x:Bind IsSuggestedKeep, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="建议保留" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                                                            </Border>
                                                        </Grid>

                                                        <ItemsControl ItemsSource="{x:Bind Photos}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="10" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:DedupPhotoItem">
                                                                    <Grid
                                                                        Width="108"
                                                                        Height="108"
                                                                        Margin="3"
                                                                        Background="Transparent"
                                                                        PointerEntered="ToolThumb_PointerEntered"
                                                                        PointerExited="ToolThumb_PointerExited"
                                                                        DoubleTapped="GroupThumb_OnDoubleTapped">
                                                                        <Border
                                                                            CornerRadius="6"
                                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                            BorderThickness="1">
                                                                            <Image Source="{x:Bind Grid.Thumbnail}" Stretch="UniformToFill" />
                                                                            <ToolTipService.ToolTip>
                                                                                <ToolTip>
                                                                                    <TextBlock Text="{x:Bind Grid.Photo.FilePath}" TextWrapping="Wrap" MaxWidth="480" FontSize="12" />
                                                                                </ToolTip>
                                                                            </ToolTipService.ToolTip>
                                                                        </Border>
                                                                        <Border
                                                                            HorizontalAlignment="Stretch"
                                                                            VerticalAlignment="Bottom"
                                                                            CornerRadius="0,0,6,6"
                                                                            Background="{StaticResource ThumbCaptionBrush}">
                                                                            <TextBlock
                                                                                Margin="7,5,26,5"
                                                                                Text="{x:Bind Grid.FileName}"
                                                                                FontSize="10"
                                                                                Foreground="White"
                                                                                TextTrimming="CharacterEllipsis" />
                                                                        </Border>
                                                                        <Border
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Top"
                                                                            Margin="4"
                                                                            Padding="1"
                                                                            CornerRadius="5"
                                                                            Background="#E6FFFFFF"
                                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                            BorderThickness="1">
                                                                            <CheckBox
                                                                                IsChecked="{x:Bind IsMarkedForDelete, Mode=TwoWay}"
                                                                                Foreground="#FF000000"
                                                                                MinWidth="0"
                                                                                MinHeight="0"
                                                                                VerticalAlignment="Center"
                                                                                ToolTipService.ToolTip="标记为删除（移入回收站）" />
                                                                        </Border>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ProgressRing
                Width="48"
                Height="48"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>

        <Grid
            Grid.Row="3"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="12"
            Padding="0,6,0,0"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="SelectDeletable_OnClick" Content="全选可删除" />
                <Button Click="ClearSelection_OnClick" Content="全不选" />
            </StackPanel>
            <TextBlock
                Grid.Column="1"
                Text="{x:Bind ViewModel.MarkedText, Mode=OneWay}"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button
                Grid.Column="2"
                Click="Delete_OnClick"
                IsEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock Text="删除选中（回收站）" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
