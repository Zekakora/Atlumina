<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyAlbum_App.Pages.MapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MyAlbum_App.ViewModels"
    xmlns:conv="using:MyAlbum_App.Converters"
    xmlns:ctrl="using:MyAlbum_App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Padding="12,8">
            <Button Click="FillGps_OnClick" ToolTipService.ToolTip="扫描缺少 GPS 的照片，按拍摄时间分组并设置位置">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE7BA;" FontSize="14" />
                    <TextBlock Text="GPS 补全工具…" />
                </StackPanel>
            </Button>
            <Button Click="Refresh_OnClick" ToolTipService.ToolTip="刷新">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ProgressBar
                Width="140"
                Height="4"
                VerticalAlignment="Center"
                IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <WebView2
                x:Name="MapView"
                DefaultBackgroundColor="Transparent" />

            <!-- Time span ruler (bottom-left) + 时光机 -->
            <Border
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="12"
                Padding="8,4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.HasGpsRange, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                        <TextBlock
                            Text="时间范围"
                            FontSize="11"
                            Opacity="0.8"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="倍速"
                            FontSize="11"
                            Opacity="0.8"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox
                            Grid.Column="2"
                            x:Name="TimeMachineSpeed"
                            Text="1"
                            FontSize="10"
                            MinWidth="44"
                            MaxWidth="44"
                            Height="22"
                            MinHeight="22"
                            MaxHeight="22"
                            Padding="2,0"
                            VerticalAlignment="Center"
                            TextAlignment="Center"
                            TextChanged="TimeMachineSpeed_OnTextChanged"
                            ToolTipService.ToolTip="时光机播放倍数（0.1× ~ 20×）">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Grid>
                                        <Border
                                            x:Name="BorderElement"
                                            Background="{ThemeResource TextControlBackground}"
                                            BorderBrush="{ThemeResource TextControlBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <ScrollViewer
                                                x:Name="ContentElement"
                                                HorizontalScrollBarVisibility="Hidden"
                                                VerticalScrollBarVisibility="Hidden"
                                                HorizontalScrollMode="Disabled"
                                                VerticalScrollMode="Auto"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                IsTabStop="False"
                                                ZoomMode="Disabled"
                                                AutomationProperties.AccessibilityView="Raw" />
                                        </Border>
                                    </Grid>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <Button
                            Grid.Column="3"
                            x:Name="TimeMachineButton"
                            Click="TimeMachine_OnClick"
                            Padding="8,2"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="时光机：按当前聚合与所选日期，沿大圆曲线按时间顺序逐点游览">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE823;" FontSize="12" />
                                <TextBlock x:Name="TimeMachineButtonText" Text="时光机" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ctrl:MapTimeRuler x:Name="TimeRuler" />
                </StackPanel>
            </Border>

            <!-- Cluster photos side panel -->
            <Border
                Width="320"
                MaxHeight="560"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Margin="0,8,12,8"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.HasCluster, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.ClusterTitle, Mode=OneWay}" />
                        <Button
                            Grid.Column="1"
                            Padding="4"
                            ToolTipService.ToolTip="关闭"
                            Click="CloseCluster_OnClick">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                    </Grid>
                    <GridView
                        Grid.Row="1"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="ClusterGrid_OnItemClick"
                        DoubleTapped="ClusterGrid_OnDoubleTapped"
                        ItemsSource="{x:Bind ViewModel.ClusterItems, Mode=OneWay}">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:MapClusterItem">
                                <StackPanel Width="84" Spacing="4" Margin="2">
                                    <Border
                                        Height="84"
                                        CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Image Source="{x:Bind ThumbImage}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock
                                        Text="{x:Bind File}"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis"
                                        FontSize="11"
                                        HorizontalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>
                </Grid>
            </Border>
        </Grid>

        <!-- Selected photo info bar -->
        <Border
            Grid.Row="2"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            Padding="14,8"
            Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Spacing="24">
                <TextBlock Text="{x:Bind ViewModel.SelectedFile, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.SelectedTime, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.SelectedGps, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.SelectedCamera, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.SelectedLens, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.SelectedExposure, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
