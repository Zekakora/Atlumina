<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyAlbum_App.Pages.QualityToolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MyAlbum_App.ViewModels"
    xmlns:conv="using:MyAlbum_App.Converters"
    xmlns:controls="using:MyAlbum_App.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InvertBoolConverter x:Key="InvertBool" />
        <LinearGradientBrush
            x:Key="ThumbCaptionBrush"
            StartPoint="0,0"
            EndPoint="0,1">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#66000000" Offset="0.45" />
            <GradientStop Color="#E6000000" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="GroupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Page.Resources>

    <Grid Padding="20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ProtectionBanner Grid.Row="0" />

        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="低质量照片清理" FontSize="20" FontWeight="SemiBold" />
            <TextBlock
                Text="整合照片质量分析（清晰度）与照片美学分析（NIMA 评分）：模糊或美学低分的照片会按「同一文件夹 + 相同主文件名」归为一组，整组删除进回收站。双击缩略图可查看大图。"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- 分析按钮 + 进度 -->
        <StackPanel Grid.Row="2" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.AnalyzeCommand}"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InvertBool}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE943;" FontSize="14" />
                        <TextBlock Text="开始分析（清晰度 + 美学评分）" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.CancelAnalyzeCommand}"
                        Visibility="{x:Bind ViewModel.IsAnalyzing, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                        <TextBlock Text="取消" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.RefreshCommand}"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InvertBool}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ProgressBar Height="4" Minimum="0" Maximum="1"
                         Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.IsAnalyzing, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.IsAnalyzing, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 搜索 -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10"
              Visibility="{x:Bind ViewModel.HasGroups, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <TextBox
                PlaceholderText="按文件名过滤…"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedText, Mode=OneWay}"
                       VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- 分组列表 -->
        <Grid Grid.Row="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:QualityGroupItem">
                            <Border Style="{StaticResource GroupCardStyle}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <CheckBox
                                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                        VerticalAlignment="Top"
                                        MinWidth="0"
                                        Margin="0,3,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Stem}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Folder}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                                                <TextBlock
                                                    Text="{x:Bind ReasonText}"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    HorizontalAlignment="Right"
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                <TextBlock
                                                    Text="{x:Bind DetailText}"
                                                    FontSize="11"
                                                    HorizontalAlignment="Right"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl ItemsSource="{x:Bind PhotoItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PhotoGridItem">
                                                    <Grid
                                                        Width="96"
                                                        Height="96"
                                                        Margin="3"
                                                        Background="Transparent"
                                                        PointerEntered="ToolThumb_PointerEntered"
                                                        PointerExited="ToolThumb_PointerExited"
                                                        DoubleTapped="GroupThumb_OnDoubleTapped">
                                                        <Border
                                                            CornerRadius="6"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1">
                                                            <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                                                        </Border>
                                                        <Border
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Bottom"
                                                            CornerRadius="0,0,6,6"
                                                            Background="{StaticResource ThumbCaptionBrush}">
                                                            <TextBlock
                                                                Margin="7,5"
                                                                Text="{x:Bind FileName}"
                                                                FontSize="10"
                                                                Foreground="White"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ProgressRing
                Width="48"
                Height="48"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>

        <!-- 底部操作 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Click="Close_OnClick" Content="关闭" />
            <Button
                Command="{x:Bind ViewModel.DeleteCommand}"
                IsEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock Text="删除选中的低质量照片组" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
