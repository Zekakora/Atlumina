<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyAlbum_App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MyAlbum_App"
    xmlns:vm="using:MyAlbum_App.ViewModels"
    xmlns:conv="using:MyAlbum_App.Converters"
    xmlns:controls="using:MyAlbum_App.Controls"
    xmlns:models="using:MyAlbum.Core.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InvertBoolConverter x:Key="InvertBool" />
        <conv:StarGlyphConverter x:Key="StarGlyph" />
        <conv:StarBrushConverter x:Key="StarBrush" />
        <!-- 自适应瀑布流网格：组头模板 + 照片瓦片模板 + 行模板 + 选择器 -->
        <DataTemplate x:Key="GridHeaderTemplate" x:DataType="vm:PhotoGroupHeaderItem">
            <TextBlock
                Text="{x:Bind Title}"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Margin="4,14,4,8"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </DataTemplate>
        <DataTemplate x:Key="GridTileTemplate" x:DataType="vm:PhotoGridItem">
            <Grid
                Width="{x:Bind TileWidth, Mode=OneWay}"
                Height="{x:Bind TileSize, Mode=OneWay}"
                PointerEntered="Tile_PointerEntered"
                PointerExited="Tile_PointerExited"
                Tapped="GridTile_OnTapped"
                DoubleTapped="GridTile_OnDoubleTapped"
                RightTapped="GridTile_OnRightTapped">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="在资源管理器中显示" Click="RevealInExplorer_OnClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8DA;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="重新获取地理位置及规范" Click="RefreshLocations_OnClick" />
                        <MenuFlyoutItem Text="重新获取地理位置及规范（相似复用）" Click="RefreshLocationsReuse_OnClick" />
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Border
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                </Border>
                <Border
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    CornerRadius="0,0,8,8"
                    Background="{StaticResource ThumbCaptionBrush}">
                    <StackPanel Margin="8,6">
                        <TextBlock Text="{x:Bind FileName}" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind TakenAtUtc}" FontSize="10" Foreground="#B3FFFFFF" />
                    </StackPanel>
                </Border>
                <FontIcon
                    Glyph="&#xE734;"
                    FontSize="12"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="8"
                    Visibility="{x:Bind HasRating, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                <!-- 多选高亮边框 + 勾选角标 -->
                <Border
                    CornerRadius="8"
                    BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    BorderThickness="2"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                <FontIcon
                    Glyph="&#xE73E;"
                    FontSize="14"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="6"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="GridRowTemplate" x:DataType="vm:PhotoGridRow">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ItemsRepeater ItemsSource="{x:Bind Items}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:PhotoGridItem">
                            <ContentControl
                                IsTabStop="False"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                ContentTemplate="{StaticResource GridTileTemplate}"
                                Content="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </DataTemplate>
        <vm:GridItemTemplateSelector
            x:Key="GridItemTemplateSelector"
            HeaderTemplate="{StaticResource GridHeaderTemplate}"
            RowTemplate="{StaticResource GridRowTemplate}" />
        <LinearGradientBrush
            x:Key="ThumbCaptionBrush"
            StartPoint="0,0"
            EndPoint="0,1">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#66000000" Offset="0.45" />
            <GradientStop Color="#E6000000" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="6,12,0,4" />
        </Style>
        <!-- Compact collapsible sidebar section (no card background, chevron on the right). -->
        <Style x:Key="SidebarExpanderStyle" TargetType="Expander">
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
    </Page.Resources>

    <Grid x:Name="HomeRoot" KeyDown="HomePage_OnKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ProtectionBanner Grid.Row="0" />

        <!-- Home toolbar -->
        <Grid
            Grid.Row="1"
            Padding="12,8"
            ColumnDefinitions="*,Auto,*"
            ColumnSpacing="8">
            <!-- Left: view / filter / tools -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ToggleButton
                    IsChecked="{x:Bind ViewModel.IsPhotoView, Mode=OneWay}"
                    Command="{x:Bind ViewModel.SetViewCommand}"
                    CommandParameter="Grid"
                    Content="网格" />
                <ToggleButton
                    IsChecked="{x:Bind ViewModel.IsCalendarView, Mode=OneWay}"
                    Command="{x:Bind ViewModel.SetViewCommand}"
                    CommandParameter="Calendar"
                    Content="日历" />
                <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,2" />
                <Button Command="{x:Bind ViewModel.ClearFiltersCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE894;" FontSize="14" />
                        <TextBlock Text="清除筛选" />
                    </StackPanel>
                </Button>
                <DropDownButton ToolTipService.ToolTip="整理工具：去重检测 / 拍摄时间修复 / 低质量照片清理 / GPS 补全 / 格式清理 / 数据库与文件对比">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock Text="工具" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="去重检测" Click="FindDuplicates_OnClick" />
                            <MenuFlyoutItem Text="拍摄时间修复" Click="FixPhotoDates_OnClick" />
                            <MenuFlyoutItem Text="低质量照片清理" Click="QualityCleanup_OnClick" />
                            <MenuFlyoutItem Text="GPS 补全" Click="GpsTool_OnClick" />
                            <MenuFlyoutItem Text="格式清理" Click="FormatCleanup_OnClick" />
                            <MenuFlyoutItem Text="数据库与文件对比" Click="DbFileDiff_OnClick" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="刷新并对比文件夹（增量导入新增/删除）">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>

            <!-- Center: refresh scan progress + change summary -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar
                    Width="140"
                    Height="4"
                    VerticalAlignment="Center"
                    Minimum="0"
                    Maximum="1"
                    Value="{x:Bind ViewModel.ScanProgress, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.ScanProgressText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <FontIcon
                    x:Name="ScanSummaryIcon"
                    Glyph="&#xE73E;"
                    FontSize="13"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Visibility="{x:Bind ViewModel.HasScanSummary, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.ScanSummary, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.ScanFailureToolTip, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasScanSummary, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <!-- 右键「重新获取地理位置及规范」批量进度（与扫描进度互斥显示） -->
                <ProgressBar
                    Width="140"
                    Height="4"
                    VerticalAlignment="Center"
                    Minimum="0"
                    Maximum="1"
                    Value="{x:Bind ViewModel.LocationProgress, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsRefreshingLocation, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.LocationProgressText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsRefreshingLocation, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    FontSize="11"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>

            <!-- Right: filter status -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,2" />
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    Margin="4,0,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Three-column body (collapsible, with drag splitters) -->
        <Grid x:Name="BodyGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="240" MinWidth="160" MaxWidth="480" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition x:Name="CenterColumn" Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition x:Name="RightColumn" Width="320" MinWidth="240" MaxWidth="700" />
            </Grid.ColumnDefinitions>

            <!-- Left splitter -->
            <Thumb
                x:Name="LeftSplitter"
                Grid.Column="1"
                Width="8"
                HorizontalAlignment="Stretch"
                DragDelta="LeftSplitter_OnDragDelta"
                Background="Transparent">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Rectangle Width="1" HorizontalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <!-- Right splitter -->
            <Thumb
                x:Name="RightSplitter"
                Grid.Column="3"
                Width="8"
                HorizontalAlignment="Stretch"
                DragDelta="RightSplitter_OnDragDelta"
                Background="Transparent">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Rectangle Width="1" HorizontalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <!-- LEFT: folder tree / camera / rating / tags -->
            <Grid x:Name="LeftPanel" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <ScrollViewer>
                    <StackPanel Padding="8,10,8,16" Spacing="10">
                        <Expander Style="{StaticResource SidebarExpanderStyle}">
                            <Expander.Header>
                                <TextBlock Text="图库" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,2" />
                            </Expander.Header>
                            <TreeView
                                ItemsSource="{x:Bind ViewModel.FolderTree, Mode=OneWay}"
                                ItemInvoked="FolderTree_OnItemInvoked">
                                <TreeView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FolderTreeNode">
                                        <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{x:Bind PhotoCount}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </TreeViewItem>
                                    </DataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Expander>

                        <Expander Style="{StaticResource SidebarExpanderStyle}"
                                  IsExpanded="{x:Bind ViewModel.IsLocationSectionOpen, Mode=TwoWay}">
                            <Expander.Header>
                                <TextBlock Text="地点" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,2" />
                            </Expander.Header>
                            <TreeView
                                ItemsSource="{x:Bind ViewModel.LocationTree, Mode=OneWay}"
                                ItemInvoked="LocationTree_OnItemInvoked">
                                <TreeView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LocationNode">
                                        <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE707;" FontSize="14" />
                                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Count}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </TreeViewItem>
                                    </DataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Expander>

                        <Expander Style="{StaticResource SidebarExpanderStyle}">
                            <Expander.Header>
                                <TextBlock Text="相机" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,2" />
                            </Expander.Header>
                            <ListView
                                ItemsSource="{x:Bind ViewModel.Cameras, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedCamera, Mode=TwoWay}"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CameraFilterItem">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Count}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Expander>

                        <TextBlock Text="评分" Style="{StaticResource SectionHeaderStyle}" />
                        <ComboBox
                            ItemsSource="{x:Bind ViewModel.RatingOptions, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.RatingMin, Mode=TwoWay}"
                            DisplayMemberPath="Label"
                            HorizontalAlignment="Stretch" />

                        <Expander Style="{StaticResource SidebarExpanderStyle}">
                            <Expander.Header>
                                <TextBlock Text="标签" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,2" />
                            </Expander.Header>
                            <StackPanel Spacing="2">
                                <Expander Style="{StaticResource SidebarExpanderStyle}">
                                    <Expander.Header>
                                        <TextBlock Text="手动标签" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="6,2,0,2" />
                                    </Expander.Header>
                                    <ListView
                                        ItemsSource="{x:Bind ViewModel.ManualTags, Mode=OneWay}"
                                        SelectionMode="None"
                                        IsItemClickEnabled="True"
                                        ItemClick="TagList_OnItemClick">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TagFilterItem">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Count}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Expander>
                                <Expander Style="{StaticResource SidebarExpanderStyle}">
                                    <Expander.Header>
                                        <TextBlock Text="AI 标签" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="6,2,0,2" />
                                    </Expander.Header>
                                    <ListView
                                        ItemsSource="{x:Bind ViewModel.AiTags, Mode=OneWay}"
                                        SelectionMode="None"
                                        IsItemClickEnabled="True"
                                        ItemClick="TagList_OnItemClick">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TagFilterItem">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Count}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Expander>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- CENTER: banner + home panels + timeline ruler -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    Grid.Row="0"
                    Margin="8,8,8,0"
                    IsOpen="{x:Bind AppState.IsReminderVisible, Mode=TwoWay}"
                    IsClosable="True"
                    Severity="Informational"
                    Title="AI 提醒"
                    Message="该区域用于展示 AI 分析提醒（阶段 4 提供），可在「设置」中重新打开。" />

                <Grid Grid.Row="1">
                    <!-- 自适应瀑布流照片网格（行等高、整行铺满） -->
                    <ScrollViewer
                        x:Name="PhotoScroller"
                        Loaded="PhotoScroller_OnLoaded"
                        SizeChanged="PhotoScroller_OnSizeChanged"
                        Visibility="{x:Bind ViewModel.IsPhotoView, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <ItemsRepeater
                            ItemsSource="{x:Bind ViewModel.GridSource, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl
                                        Content="{Binding}"
                                        ContentTemplateSelector="{StaticResource GridItemTemplateSelector}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        IsTabStop="False" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollViewer>

                    <!-- Calendar view -->
                        <controls:CalendarView
                            x:Name="CalendarControl"
                            DataContext="{x:Bind ViewModel}"
                            Items="{x:Bind ViewModel.CalendarCells, Mode=OneWay}"
                            Zoom="{x:Bind ViewModel.CalendarZoomLevel, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsCalendarView, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                    <!-- Day drill-down breadcrumb -->
                    <Border
                        Visibility="{x:Bind ViewModel.HasDayFocus, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Margin="12,8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="4">
                        <Button Command="{x:Bind ViewModel.ClearDayFocusCommand}" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                <TextBlock Text="返回" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Timeline ruler overlay (hidden when not active) -->
                    <controls:TimelineRuler
                        x:Name="TimelineRuler"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Visibility="{x:Bind ViewModel.IsRulerVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>

            <!-- RIGHT: preview + info -->
            <Grid x:Name="RightPanel" Grid.Column="4" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <ScrollViewer>
                    <StackPanel
                        Spacing="10"
                        Padding="14"
                        Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                        <Image x:Name="PreviewImage" Source="{x:Bind ViewModel.PreviewImage, Mode=OneWay}" Stretch="Uniform" MaxHeight="240" HorizontalAlignment="Center" />
                        <Grid
                            ColumnSpacing="8"
                            Visibility="{x:Bind ViewModel.HasFileName, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="{x:Bind ViewModel.PreviewFileName, Mode=OneWay}"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextWrapping="Wrap"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <Button
                                Grid.Column="1"
                                Click="OpenInCameraRaw_OnClick"
                                ToolTipService.ToolTip="在外部 RAW 编辑器（ACR / Photoshop / 系统默认）中打开"
                                Padding="6,2"
                                MinWidth="0"
                                VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="12" />
                                    <TextBlock Text="ACR" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Info: icon+label+value rows, data-driven from the Settings toggles. -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.InfoRows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:InfoRow">
                                    <Grid ColumnSpacing="12" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind Label}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 拍摄位置小地图（红色图钉，可拖动/缩放） -->
                        <Border
                            Height="180"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Visibility="{x:Bind ViewModel.HasGps, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <WebView2
                                    x:Name="MiniMap"
                                    DefaultBackgroundColor="Transparent" />
                            </Grid>
                        </Border>

                        <Button Command="{x:Bind ViewModel.RefreshLocationCommand, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.HasGps, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasGps, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                ToolTipService.ToolTip="用反解 + AI 规范重新解析这张照片的位置信息">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="刷新位置信息" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="标签" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.PhotoTags, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:TagRecord">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="8,3" Margin="0,0,4,4">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{x:Bind Name}" FontSize="12" VerticalAlignment="Center" />
                                            <Button FontSize="10" Background="Transparent" BorderThickness="0" Padding="2" VerticalAlignment="Center" Click="RemoveTag_OnClick" Tag="{x:Bind Name}" ToolTipService.ToolTip="删除标签">
                                                <FontIcon Glyph="&#xE711;" FontSize="10" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBox x:Name="NewTagBox" PlaceholderText="添加标签" MinWidth="140" KeyDown="NewTagBox_OnKeyDown" />
                            <Button Click="AddTag_OnClick" ToolTipService.ToolTip="添加标签">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="评分" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Command="{x:Bind ViewModel.SetRatingCommand}" CommandParameter="1" Background="Transparent" BorderThickness="0" Padding="2" ToolTipService.ToolTip="1 星">
                                <FontIcon Glyph="{x:Bind ViewModel.Rating, Mode=OneWay, Converter={StaticResource StarGlyph}, ConverterParameter=1}" Foreground="{x:Bind ViewModel.Rating, Mode=OneWay, Converter={StaticResource StarBrush}, ConverterParameter=1}" FontSize="18" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.SetRatingCommand}" CommandParameter="2" Background="Transparent" BorderThickness="0" Padding="2" ToolTipService.ToolTip="2 星">
                                <FontIcon Glyph="{x:Bind ViewModel.Rating, Mode=OneWay, Converter={StaticResource StarGlyph}, ConverterParameter=2}" Foreground="{x:Bind ViewModel.Rating, Mode=OneWay, Converter={StaticResource StarBrush}, ConverterParameter=2}" FontSize="18" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.SetRatingCommand}" CommandParameter="3" Background="Transparent" BorderThickness="0" Padding="2" ToolTipService.ToolTip="3 星">
                                <FontIcon Glyph="{x:Bind ViewModel.Rating, Mode=OneWay, Converter={StaticResource StarGlyph}, ConverterParameter=3}" Foreground="{x:Bind ViewModel.Rating, Mode=OneWay, Converter={StaticResource StarBrush}, ConverterParameter=3}" FontSize="18" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.SetRatingCommand}" CommandParameter="4" Background="Transparent" BorderThickness="0" Padding="2" ToolTipService.ToolTip="4 星">
                                <FontIcon Glyph="{x:Bind ViewModel.Rating, Mode=OneWay, Converter={StaticResource StarGlyph}, ConverterParameter=4}" Foreground="{x:Bind ViewModel.Rating, Mode=OneWay, Converter={StaticResource StarBrush}, ConverterParameter=4}" FontSize="18" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.SetRatingCommand}" CommandParameter="5" Background="Transparent" BorderThickness="0" Padding="2" ToolTipService.ToolTip="5 星">
                                <FontIcon Glyph="{x:Bind ViewModel.Rating, Mode=OneWay, Converter={StaticResource StarGlyph}, ConverterParameter=5}" Foreground="{x:Bind ViewModel.Rating, Mode=OneWay, Converter={StaticResource StarBrush}, ConverterParameter=5}" FontSize="18" />
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Click="EditExif_OnClick" ToolTipService.ToolTip="用 ExifTool 编辑选中照片的拍摄时间/相机/评分/GPS"
                                    IsEnabled="{x:Bind AppState.ProtectOriginalData, Mode=OneWay, Converter={StaticResource InvertBool}}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                    <TextBlock Text="编辑 EXIF" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Click="BatchRename_OnClick" ToolTipService.ToolTip="按模板批量重命名当前筛选结果"
                                IsEnabled="{x:Bind AppState.ProtectOriginalData, Mode=OneWay, Converter={StaticResource InvertBool}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8C9;" FontSize="14" />
                                <TextBlock Text="批量重命名…" />
                            </StackPanel>
                        </Button>
                        <Button Click="BatchExport_OnClick" ToolTipService.ToolTip="将当前筛选结果导出到文件夹">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                <TextBlock Text="导出到文件夹…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Hover-reveal collapse/expand buttons on the panel inner edges.
                 Must be the LAST child of the body grid (renders on top of both panels)
                 and span every column so it stays reachable when a panel is collapsed. -->
            <Grid x:Name="PanelEdges" Grid.ColumnSpan="5">
                <Border
                    x:Name="LeftEdgeHit"
                    Width="40"
                    Height="64"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    CornerRadius="20"
                    PointerEntered="LeftEdge_PointerEntered"
                    PointerExited="LeftEdge_PointerExited">
                    <Button
                        x:Name="LeftEdgeButton"
                        Width="34"
                        Height="34"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        CornerRadius="17"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed"
                        Click="LeftEdgeButton_OnClick">
                        <FontIcon x:Name="LeftEdgeIcon" FontSize="14" />
                    </Button>
                </Border>
                <Border
                    x:Name="RightEdgeHit"
                    Width="40"
                    Height="64"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    CornerRadius="20"
                    PointerEntered="RightEdge_PointerEntered"
                    PointerExited="RightEdge_PointerExited">
                    <Button
                        x:Name="RightEdgeButton"
                        Width="34"
                        Height="34"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        CornerRadius="17"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed"
                        Click="RightEdgeButton_OnClick">
                        <FontIcon x:Name="RightEdgeIcon" FontSize="14" />
                    </Button>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>


