<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyAlbum_App.Pages.DateFixToolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MyAlbum_App.ViewModels"
    xmlns:conv="using:MyAlbum_App.Converters"
    xmlns:controls="using:MyAlbum_App.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Padding="20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ProtectionBanner Grid.Row="0" />

        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="拍摄时间修复" FontSize="20" FontWeight="SemiBold" />
            <TextBlock
                Text="仅修改文件系统时间戳（创建时间，可选修改时间），EXIF 数据与文件内容保持原样。"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <ComboBox
                ItemsSource="{x:Bind ViewModel.FilterOptions, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedFilter, Mode=TwoWay}"
                DisplayMemberPath="Label"
                HorizontalAlignment="Stretch"
                ToolTipService.ToolTip="筛选要显示的照片" />
            <CheckBox
                Grid.Column="1"
                Content="全选 / 全不选"
                IsChecked="{x:Bind ViewModel.SelectAll, Mode=TwoWay}"
                VerticalAlignment="Center" />
            <CheckBox
                Grid.Column="2"
                Content="同时修改文件“修改时间”"
                IsChecked="{x:Bind ViewModel.FixModified, Mode=TwoWay}"
                VerticalAlignment="Center" />
        </Grid>

        <Border
            Grid.Row="3"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="0,6">
            <Grid>
                <ListView
                    ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.Header>
                        <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="12" Padding="4,0,4,8">
                            <TextBlock
                                Grid.Column="1"
                                Text="文件"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="10">
                                <StackPanel Width="150">
                                    <TextBlock
                                        Text="当前创建时间"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextAlignment="Right" />
                                </StackPanel>
                                <FontIcon Glyph="&#xE72A;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <StackPanel Width="150">
                                    <TextBlock
                                        Text="修改后（拍摄时间）"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextAlignment="Right" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PhotoDateFixItem">
                            <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="12" Padding="4,6" MinHeight="54">
                                <CheckBox
                                    IsChecked="{x:Bind Selected, Mode=TwoWay}"
                                    IsEnabled="{x:Bind IsFixable}"
                                    Visibility="{x:Bind IsFixable, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    MinWidth="0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Folder}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind IsFixable, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Width="150" Spacing="1">
                                        <TextBlock Text="{x:Bind CurrentCreatedText}" FontSize="12" TextAlignment="Right" />
                                    </StackPanel>
                                    <FontIcon Glyph="&#xE72A;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Width="150" Spacing="1">
                                        <TextBlock Text="{x:Bind TargetCreatedText}" FontSize="12" FontWeight="SemiBold" TextAlignment="Right" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind StatusText}"
                                    VerticalAlignment="Center"
                                    FontStyle="Italic"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="{x:Bind IsNotFixable, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ProgressRing
                    Width="48"
                    Height="48"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TextBlock
            Grid.Row="4"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Click="Close_OnClick" Content="关闭" />
            <Button
                Click="Fix_OnClick"
                IsEnabled="{x:Bind ViewModel.CanFix, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                    <TextBlock Text="{x:Bind ViewModel.FixText, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
