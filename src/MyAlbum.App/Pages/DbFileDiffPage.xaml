<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyAlbum_App.Pages.DbFileDiffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MyAlbum_App.ViewModels"
    xmlns:conv="using:MyAlbum_App.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="BadgeBaseStyle" TargetType="Border">
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BadgeMatchStyle" TargetType="Border" BasedOn="{StaticResource BadgeBaseStyle}">
            <Setter Property="Background" Value="#1A107C10" />
        </Style>
        <Style x:Key="BadgeDiffStyle" TargetType="Border" BasedOn="{StaticResource BadgeBaseStyle}">
            <Setter Property="Background" Value="#1A9D5D00" />
        </Style>
        <Style x:Key="BadgeMissingStyle" TargetType="Border" BasedOn="{StaticResource BadgeBaseStyle}">
            <Setter Property="Background" Value="#1AC42B1C" />
        </Style>
    </Page.Resources>

    <Grid Padding="20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Spacing="4">
            <TextBlock Text="数据库与文件对比" FontSize="20" FontWeight="SemiBold" />
            <TextBlock
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.ScanCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="扫描差异" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.CancelScanCommand}"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                        <TextBlock Text="取消" />
                    </StackPanel>
                </Button>
                <ComboBox
                    ItemsSource="{x:Bind ViewModel.FilterOptions}"
                    DisplayMemberPath="Label"
                    SelectedItem="{x:Bind ViewModel.SelectedFilter, Mode=TwoWay}"
                    MinWidth="150"
                    VerticalAlignment="Center" />
                <ProgressBar
                    Width="220"
                    Height="4"
                    Minimum="0"
                    Maximum="1"
                    Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="SelectAll_OnClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                        <TextBlock Text="全选" />
                    </StackPanel>
                </Button>
                <Button Click="ClearSelection_OnClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                        <TextBlock Text="全不选" />
                    </StackPanel>
                </Button>
                <InfoBar
                    IsOpen="{x:Bind ViewModel.ProtectionEnabled, Mode=OneWay}"
                    Severity="Warning"
                    IsClosable="False"
                    Message="已开启「保护原始照片」：数据库写入照片（库→文件）被禁止。"
                    HorizontalAlignment="Left" />
            </StackPanel>
        </StackPanel>

        <!-- List -->
        <Grid Grid.Row="2">
            <ListView
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                SelectionMode="None"
                Padding="0,0,0,8">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DbFileDiffItem">
                        <Grid Padding="8,8" ColumnSpacing="12"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox
                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                IsEnabled="{x:Bind CanAction}"
                                MinWidth="0"
                                MinHeight="0"
                                VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <Border Style="{StaticResource BadgeMatchStyle}"
                                            Visibility="{x:Bind IsMatch, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="无差异" FontSize="10" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Style="{StaticResource BadgeDiffStyle}"
                                            Visibility="{x:Bind HasDiff, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="有差异" FontSize="10" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Style="{StaticResource BadgeMissingStyle}"
                                            Visibility="{x:Bind IsMissing, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="文件缺失" FontSize="10" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>

                                <TextBlock
                                    Text="{x:Bind Folder}"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Folder}" />

                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE714;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind CameraText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE823;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind TakenText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE950;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind FileSizeText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="库内修改：" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind DbModifiedText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock
                                    Text="{x:Bind ChangedText}"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Visibility="{x:Bind HasDiff, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="上次修改时间" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind FileModifiedText}" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ProgressRing
                Width="48"
                Height="48"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>

        <!-- Footer -->
        <Grid
            Grid.Row="3"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="12"
            Padding="0,6,0,0"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <TextBlock
                Text="{x:Bind ViewModel.SelectedText, Mode=OneWay}"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button
                Grid.Column="1"
                Click="Overwrite_OnClick"
                IsEnabled="{x:Bind ViewModel.CanOverwrite, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    <TextBlock Text="覆盖数据库（照片→库）" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="2"
                Click="WriteBack_OnClick"
                IsEnabled="{x:Bind ViewModel.CanWriteBack, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                    <TextBlock Text="数据库写入照片（库→文件）" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
