<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyAlbum_App.Pages.PeoplePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MyAlbum_App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Padding="14,10">
            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <GridView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.People, Mode=OneWay}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="PersonCard_OnItemClick"
            Padding="16">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="6" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:PersonItem">
                    <Grid>
                        <Border
                            Width="200"
                            MinHeight="120"
                            CornerRadius="10"
                            Padding="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="6">
                                <Border Width="120" Height="120" CornerRadius="60"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind Summary}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button
                            Width="26"
                            Height="26"
                            MinWidth="0"
                            MinHeight="0"
                            Padding="0"
                            CornerRadius="13"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Tag="{x:Bind}"
                            Click="DeletePerson_OnClick"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            ToolTipService.ToolTip="删除该人物">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="重命名…" Tag="{x:Bind}" Click="RenamePerson_OnClick" />
                                <MenuFlyoutItem Text="合并到…" Tag="{x:Bind}" Click="MergePerson_OnClick" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="删除…" Tag="{x:Bind}" Click="DeletePerson_OnClick" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
