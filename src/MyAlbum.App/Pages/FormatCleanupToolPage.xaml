<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyAlbum_App.Pages.FormatCleanupToolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MyAlbum_App.ViewModels"
    xmlns:conv="using:MyAlbum_App.Converters"
    xmlns:controls="using:MyAlbum_App.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <LinearGradientBrush
            x:Key="ThumbCaptionBrush"
            StartPoint="0,0"
            EndPoint="0,1">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#66000000" Offset="0.45" />
            <GradientStop Color="#E6000000" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="GroupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Page.Resources>

    <Grid Padding="20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ProtectionBanner Grid.Row="0" />

        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="格式清理" FontSize="20" FontWeight="SemiBold" />
            <TextBlock
                Text="勾选要处理的组，再选择要保留的格式；未保留的格式将移入回收站。双击缩略图可查看大图。"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox
                PlaceholderText="按文件名过滤…"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox
                Grid.Column="1"
                Content="全选 / 全不选"
                IsChecked="{x:Bind ViewModel.SelectAll, Mode=TwoWay}"
                VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FormatGroupItem">
                            <Border Style="{StaticResource GroupCardStyle}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <CheckBox
                                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                        VerticalAlignment="Top"
                                        MinWidth="0"
                                        Margin="0,3,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Stem}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Folder}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind FormatsText}"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{x:Bind PhotoItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PhotoGridItem">
                                                    <Grid
                                                        Width="96"
                                                        Height="96"
                                                        Margin="3"
                                                        Background="Transparent"
                                                        PointerEntered="ToolThumb_PointerEntered"
                                                        PointerExited="ToolThumb_PointerExited"
                                                        DoubleTapped="GroupThumb_OnDoubleTapped">
                                                        <Border
                                                            CornerRadius="6"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1">
                                                            <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                                                        </Border>
                                                        <Border
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Bottom"
                                                            CornerRadius="0,0,6,6"
                                                            Background="{StaticResource ThumbCaptionBrush}">
                                                            <TextBlock
                                                                Margin="7,5"
                                                                Text="{x:Bind FileName}"
                                                                FontSize="10"
                                                                Foreground="White"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ProgressRing
                Width="48"
                Height="48"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="4" Spacing="4" Margin="0,4,0,0">
            <TextBlock Text="保留格式（应用到选中组）" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.KeepFormats, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FormatKeepOption">
                        <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsKeep, Mode=TwoWay}" Margin="0,0,16,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <TextBlock
            Grid.Row="5"
            Text="{x:Bind ViewModel.PreviewText, Mode=OneWay}"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Click="Close_OnClick" Content="关闭" />
            <Button
                Click="Delete_OnClick"
                IsEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock Text="删除未保留格式" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
